{
  "version": "1.0",
  "description": "Curated ligand–receptor pairs relevant to the BBB neurovascular unit. Direction reflects canonical signaling (sender → receiver). Subset of CellChatDB / OmniPath restricted to vascular cell types in this atlas.",
  "pairs": [
    {"ligand": "PDGFB", "receptor": "PDGFRB", "sender_pref": "Cap_EC", "receiver_pref": "Pericyte", "pathway": "PDGF", "note": "PDGF-B from EC recruits pericytes during angiogenesis & maintains pericyte coverage."},
    {"ligand": "ANGPT1", "receptor": "TEK", "sender_pref": "Pericyte", "receiver_pref": "Cap_EC", "pathway": "Angiopoietin", "note": "Pericyte-derived Ang1 stabilizes EC junctions through Tie2."},
    {"ligand": "ANGPT2", "receptor": "TEK", "sender_pref": "Cap_EC", "receiver_pref": "Cap_EC", "pathway": "Angiopoietin", "note": "Ang2 destabilizes Tie2 — increased in BBB breakdown."},
    {"ligand": "VEGFA", "receptor": "KDR", "sender_pref": "Pericyte", "receiver_pref": "Cap_EC", "pathway": "VEGF", "note": "Pericyte/astrocyte VEGF can drive EC proliferation; also breaks down TJs in pathology."},
    {"ligand": "VEGFA", "receptor": "FLT1", "sender_pref": "Pericyte", "receiver_pref": "Cap_EC", "pathway": "VEGF"},
